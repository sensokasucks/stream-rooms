+PackedStringArray SpoutTexture::get_sender_names() {
+  PackedStringArray out;
+  spoutSenderNames names;
+  std::set<std::string> found;
+  if (names.GetSenderNames(&found)) {
+    for (const auto &n : found) {
+      out.push_back(String::utf8(n.c_str()));
+    }
+  }
+  return out;
