extends RefCounted
## Cabin: Frozen North, the outside of the Log Cabin's fourth scene room (rooms/cabin_north/ uses
## log_cabin_room.gd with scene = "north"; the plan is Sen's "Log Cabin room plan" doc, "Outdoor
## scenes": deep snow, snow-loaded spruce and fir, a frozen lake with wind-polished ice, low
## mountains, snowshoes by the door, a sled, frost on the window corners, aurora on clear nights).
## Built in code when the room loads, like the rest of the cabin. It is laid out like Cabin:
## Lakeside (cabin_lake.gd), with the lake frozen over:
##   - the land: the flat yard round the cabin, a slope in front of the deck down to the shore
##     and the frozen lake beyond, two wooded arms of the shore to the sides, a slope with forest
##     behind, a small wooded island out on the ice. One mesh, finer near the cabin (height() for
##     anything standing on it). It is all under snow: the room keeps "Snow on the ground" at
##     least SNOW_FLOOR here (log_cabin_room.gd hands it to the weather as its snow_floor), and
##     the surface shader whitens whatever faces up,
##   - the ice: one huge flat sheet at ICE_Y with its own shader (cabin_ice.gdshader): dark,
##     glassy ice polished by the wind, mirroring the sky, with drifts of snow blown across it,
##     white cracks and pressure ridges; lit like everything else,
##   - spruces (the campfire's leaf-card firs, darker and narrower) and a few pines on the
##     Detailed look, plain shapes on the Simple one, and a far forest of low-poly firs on the arms,
##     the slope behind and the island; the weather frosts them pale and heaps snow on the
##     detailed boughs (room_weather.gd tree_snow, camp_foliage.gdshader snow_load),
##   - snowshoes leaning by the corner glass door, a wooden sled at the foot of the deck steps,
##     granite boulders under snow caps, and a trodden path in the snow from the steps down onto
##     the ice.
## The aurora is the sky's (camp_sky.gdshader `aurora_amount`, which hangs its curtains in the
## north, straight out over the ice); the room sets it from "cabin_aurora" on clear nights. The
## ice's creaks and booms are generated by the room script (log_cabin_room.gd _run_ice).
## Everything is placed with fixed seeds, so every PC in a co-stream sees the same place.
## build() hands back what Builder.build() does (the room script uses the same keys) plus:
##   ice_mat     the ice's material (the room script leaves it alone: it is lit by the sun),
##   leaf_mats   the leaf-card materials by name,
##   far_trees   the low-poly tree MultiMeshInstance3Ds.

const Builder := preload("res://rooms/log_cabin/cabin_builder.gd")
const CampBuilder := preload("res://rooms/campfire/campfire_builder.gd")
const Trees := preload("res://rooms/campfire/campfire_trees.gd")
const ICE_SHADER := preload("res://rooms/log_cabin/cabin_ice.gdshader")
const CAMP_TEX := "res://rooms/campfire/textures/"

## The middle of the flat yard round the cabin (x, z) and how far out it stays flat (metres).
## (The lake room's yard, so the cameras fit both.)
const YARD := Vector2(-2.5, 2.0)
const YARD_R: float = 19.0
## The ice (y, metres): 2.6 m below the yard, so the deck looks down onto it.
const ICE_Y: float = Builder.GROUND_Y - 2.6
## How far the shore is from the yard's middle straight out in front of the deck (metres). To
## the sides it is further (shore_r()): the two arms of the shore.
const SHORE_FRONT: float = 34.0
## The island out on the ice (x, z) and its radius (metres).
const ISLAND := Vector2(70.0, -250.0)
const ISLAND_R: float = 40.0
## The land mesh: how far out it reaches each way (metres) and how many rows and columns; the
## rows bunch up near the cabin (LAND_BUNCH).
const LAND_SIZE: float = 900.0
const LAND_CELLS: int = 250
const LAND_BUNCH: float = 2.6
## The detailed trees: how many, and how far from the yard's middle they stand (metres).
const TREE_COUNT: int = 280
const TREE_RANGE := Vector2(15.0, 130.0)
## The far low-poly forest: how many trees and where (metres from the yard's middle).
const FAR_COUNT: int = 4200
const FAR_RANGE := Vector2(100.0, 520.0)
## Roughly where a seated person's eyes are on the deck: nothing in front of the deck stands
## above this, so the view down to the ice stays open.
const VIEW_Y: float = 0.9
## The least snow lying on the ground here, 0..1 (the "Snow on the ground" slider can add to it
## but never take the north's snow away).
const SNOW_FLOOR: float = 0.85
## Where the trodden path starts (the foot of the deck steps) and which way it heads (x, z).
const PATH_START := Vector2(6.8, -4.8)
const PATH_DIR := Vector2(0.3, -0.95)
const C_SNOW := Color(0.88, 0.91, 0.96)
const C_TRODDEN := Color(0.74, 0.77, 0.83)       # packed snow on the path, a little grey-blue
const C_CANOPY := Color(0.05, 0.09, 0.08)        # far slopes: the dark between snowy spruces
const C_GRANITE := Color(0.5, 0.5, 0.5)
const C_SLED := Color(0.62, 0.36, 0.18)          # an old varnished wooden sled
const C_RUNNER := Color(0.6, 0.14, 0.1)          # its painted red runners
const C_SHOE_FRAME := Color(0.58, 0.42, 0.24)    # bent ash snowshoe frames
const C_SHOE_LACE := Color(0.82, 0.72, 0.55)     # rawhide lacing


## The cabin and the frozen lake round it, under `room`. Returns the parts (see the file's header).
static func build(room: Node3D, view: String) -> Dictionary:
	var out := Builder.build_cabin(room, view)
	out["smoke_spots"] = Builder.SMOKE_SPOTS
	out["shelters"] = Builder.shelters()
	out["eaves"] = Builder.eaves()
	var set_root := room.get_node("Set") as Node3D
	var surf: Dictionary = out["surface_mats"]
	out["litter_mat"] = surf[Builder.S_LITTER]
	_build_land(set_root, surf)
	_build_ice(set_root, out)
	_build_snow_things(set_root, surf)
	var rng := RandomNumberGenerator.new()
	rng.seed = 1896
	var trees := _place_trees(rng)
	var far_mat := CampBuilder._prop_material(0.05)
	var shapes := _lowpoly_shapes()
	out["far_trees"] = _build_far_forest(set_root, rng, shapes, far_mat)
	out["simple_trees"] = _build_simple_trees(set_root, trees, shapes, far_mat)
	out["detailed_plants"] = _build_detailed_plants(set_root, trees, rng)
	var leaf_mats: Dictionary = (out["detailed_plants"] as Node3D).get_meta("mats")
	out["leaf_mats"] = leaf_mats
	var tree_mats: Array = leaf_mats.values()
	tree_mats.append(far_mat)
	out["tree_mats"] = tree_mats
	return out


# ── The land ─────────────────────────────────────────────────
## Metres from the yard's middle to the shore in the direction of x, z: SHORE_FRONT straight out
## in front of the deck, further and further to the sides (the arms curve away forwards), and
## the land never ends behind the cabin (cabin_lake.gd's shape, a different wobble).
static func shore_r(x: float, z: float) -> float:
	var dx := x - YARD.x
	var dz := z - YARD.y
	var r := maxf(sqrt(dx * dx + dz * dz), 0.01)
	var ahead := -dz / r                          # 1 straight out from the deck, -1 straight behind
	var open := smoothstep(-0.1, 0.85, ahead)
	var ang := atan2(dx, -dz)
	var wobble := 1.0 + 0.08 * sin(ang * 6.0 + 2.1) + 0.04 * sin(ang * 15.0 + 0.7)
	return SHORE_FRONT / maxf(open, 0.04) * wobble


## The ground's height (metres) at x, z. Flat in the yard; in front, the slope down to the shore
## and on under the ice; behind, the wooded slope rises higher than at the lake (the hills of the
## north); to the sides, wooded hills down to the shore. The island rises out of the ice.
## Everything that stands on the ground asks this.
static func height(x: float, z: float) -> float:
	var dx := x - YARD.x
	var dz := z - YARD.y
	var r := sqrt(dx * dx + dz * dz)
	var ahead := -dz / maxf(r, 0.01)
	var back := smoothstep(0.15, 0.75, -ahead)
	var front := smoothstep(0.15, 0.75, ahead)
	var rise := back * (30.0 * smoothstep(YARD_R + 4.0, 200.0, r) + 40.0 * smoothstep(280.0, 700.0, r)) \
		+ (1.0 - back) * (12.0 * smoothstep(YARD_R + 6.0, 160.0, r) + 28.0 * smoothstep(300.0, 700.0, r)) * (1.0 - 0.5 * front)
	# (softer bumps than the lake's: the snow smooths the ground over)
	var bumps := 1.6 * sin(x * 0.041 + 0.6) * sin(z * 0.035 + 1.9) + 0.8 * sin(x * 0.1 + z * 0.08) + 0.3 * sin(z * 0.21 - x * 0.06)
	var land := Builder.GROUND_Y + rise + bumps * smoothstep(YARD_R, YARD_R + 30.0, r)
	var edge := shore_r(x, z)
	var d := r - edge                             # metres out past the shore (below 0 = on land)
	var h: float
	if d < 0.0:
		var ramp := clampf(edge - YARD_R - 1.0, 6.0, 30.0)
		h = lerpf(ICE_Y + 0.05, land, smoothstep(0.0, ramp, -d))
	else:
		h = ICE_Y + 0.05 - 3.5 * smoothstep(0.0, 25.0, d)         # under the ice
	var isl := 1.0 - smoothstep(0.0, ISLAND_R, Vector2(x, z).distance_to(ISLAND))
	if isl > 0.0:
		h = maxf(h, ICE_Y - 2.0 + 9.0 * sqrt(isl))
	return h


## Whether x, z is on the open slope in front of the deck (kept open: no trees, no rocks).
static func on_slope(x: float, z: float) -> bool:
	var dx := x - YARD.x
	var dz := z - YARD.y
	var r := sqrt(dx * dx + dz * dz)
	return r < 50.0 and -dz / maxf(r, 0.01) > 0.42 and r < shore_r(x, z) + 1.0


## Whether x, z is on the ice (or right at its edge, `margin` metres onto the land).
static func on_ice(x: float, z: float, margin: float = 0.0) -> bool:
	return height(x, z) < ICE_Y + 0.05 + margin * 0.12


## The trodden path from the deck steps down onto the ice (x, z points; the last one is a few
## metres out on the ice).
static func path_points() -> Array[Vector2]:
	var r := 0.0
	while r < 80.0 and height(PATH_START.x + PATH_DIR.x * r, PATH_START.y + PATH_DIR.y * r) > ICE_Y + 0.2:
		r += 0.25
	var end := PATH_START + PATH_DIR * (r + 6.0)
	var pts: Array[Vector2] = []
	for i in 7:
		var t := float(i) / 6.0
		# (wandering a little, as tracks in snow do)
		pts.append(PATH_START.lerp(end, t) + Vector2(1.2, 0.0) * sin(t * PI * 1.5))
	return pts


## Metres from x, z to the trodden path.
static func path_distance(x: float, z: float) -> float:
	var pts := path_points()
	var p := Vector2(x, z)
	var best := 1.0e9
	for i in pts.size() - 1:
		var a: Vector2 = pts[i]
		var ab: Vector2 = pts[i + 1] - a
		var t := clampf((p - a).dot(ab) / ab.length_squared(), 0.0, 1.0)
		best = minf(best, p.distance_to(a + ab * t))
	return best


## Whether x, z is on the cabin, the den, the deck or the back stoop (nothing grows there).
static func on_cabin(x: float, z: float, margin: float) -> bool:
	return x > Builder.DEN_FAR_X - margin and x < Builder.DECK_HALF + margin and z > -Builder.DECK_DEPTH - margin - 1.2 and z < Builder.BACK_Z + 1.6 + margin


## The land: one grid, rows and columns bunched up near the cabin, in three parts like the
## lake's (yard, shore, woods: the same surface kinds, so the weather's snow lies on all three).
## The colours are the snow's, and far out the treetops' dark between the snow (the corner
## colours' alpha drops to 0 there, so they show instead of the photo).
static func _build_land(parent: Node3D, surf: Dictionary) -> void:
	var n := LAND_CELLS + 1
	var verts := PackedVector3Array()
	var normals := PackedVector3Array()
	var colors := PackedColorArray()
	verts.resize(n * n)
	normals.resize(n * n)
	colors.resize(n * n)
	var coords := PackedFloat32Array()
	coords.resize(n)
	for i in n:
		var u := float(i) / float(LAND_CELLS) * 2.0 - 1.0
		coords[i] = signf(u) * pow(absf(u), LAND_BUNCH) * LAND_SIZE
	for j in n:
		for i in n:
			var x := coords[i] + YARD.x
			var z := coords[j] + YARD.y
			var y := height(x, z)
			var e := 0.6
			var nrm := Vector3(height(x - e, z) - height(x + e, z), 2.0 * e, height(x, z - e) - height(x, z + e)).normalized()
			var k := j * n + i
			verts[k] = Vector3(x, y, z)
			normals[k] = nrm
			var r := Vector2(x, z).distance_to(YARD)
			var mottle := 0.5 + 0.5 * sin(x * 0.21 + sin(z * 0.17) * 2.0) * sin(z * 0.23 + x * 0.05)
			var canopy := C_CANOPY.lerp(C_SNOW.darkened(0.35), 0.35 * mottle)
			var c := C_SNOW.lerp(canopy, smoothstep(70.0, 140.0, r) * smoothstep(ICE_Y + 0.6, ICE_Y + 2.5, y))
			c.a = 1.0 - smoothstep(85.0, 150.0, r)
			colors[k] = c
	var yard_idx := PackedInt32Array()
	var shore_idx := PackedInt32Array()
	var wood_idx := PackedInt32Array()
	for j in LAND_CELLS:
		for i in LAND_CELLS:
			var a := j * n + i
			var b := a + 1
			var c := a + n
			var d := c + 1
			var mid := (verts[a] + verts[d]) * 0.5
			var low := minf(minf(verts[a].y, verts[b].y), minf(verts[c].y, verts[d].y))
			# (packed arrays are copied on assignment, so append to the right one directly)
			if low < ICE_Y + 0.7:
				shore_idx.append_array([a, b, c, b, d, c])
			elif Vector2((mid.x - YARD.x) / 1.15, mid.z - YARD.y).length() < YARD_R - 3.0 or on_slope(mid.x, mid.z):
				yard_idx.append_array([a, b, c, b, d, c])
			else:
				wood_idx.append_array([a, b, c, b, d, c])
	var mesh := ArrayMesh.new()
	for part: Array in [[yard_idx, Builder.S_GRASS], [shore_idx, Builder.S_SAND], [wood_idx, Builder.S_LITTER]]:
		var arrays: Array = []
		arrays.resize(Mesh.ARRAY_MAX)
		arrays[Mesh.ARRAY_VERTEX] = verts
		arrays[Mesh.ARRAY_NORMAL] = normals
		arrays[Mesh.ARRAY_COLOR] = colors
		arrays[Mesh.ARRAY_INDEX] = part[0]
		mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
		mesh.surface_set_material(mesh.get_surface_count() - 1, surf[part[1]])
	Builder._add_mesh(parent, "Land", mesh, null, true)
	# the trodden path: a strip of packed snow a hair above the drift, slightly grey and glossier.
	# It has its own plain material, not one of the cabin's surface kinds: those all get the
	# weather's snow, which would whiten the path back into the drift.
	var g := Builder.Buf.new()
	g.mat = Builder.S_PLAIN
	var pts := path_points()
	for i in pts.size() - 1:
		var a: Vector2 = pts[i]
		var b: Vector2 = pts[i + 1]
		var side := Vector2(-(b - a).y, (b - a).x).normalized() * 0.5
		var corners: Array[Vector2] = [a - side, a + side, b + side, b - side]
		var at: Array[Vector3] = []
		for q: Vector2 in corners:
			at.append(Vector3(q.x, maxf(height(q.x, q.y), ICE_Y + 0.05) + 0.025, q.y))
		g.quad(at[0], at[1], at[2], at[3], C_TRODDEN)
	Builder._add_mesh(parent, "Path", g.to_mesh(), Builder._flat_material(0.55), false)


# ── The ice ──────────────────────────────────────────────────
## The frozen lake: one huge flat sheet at ICE_Y (the land hides it wherever it is higher) with
## cabin_ice.gdshader. Unlike the lake's water it is lit by the sun, so the room script has
## nothing to set on it each hour; the sky's noise picture breaks it into drifts and cracks.
static func _build_ice(parent: Node3D, out: Dictionary) -> void:
	var sheet := PlaneMesh.new()
	sheet.size = Vector2(3200.0, 1800.0)
	var mat := ShaderMaterial.new()
	mat.shader = ICE_SHADER
	mat.set_shader_parameter("noise", load(CAMP_TEX + "sky_noise.png"))
	out["ice_mat"] = mat
	var mi := Builder._add_mesh(parent, "Ice", sheet, mat, false)
	mi.position = Vector3(YARD.x, ICE_Y, YARD.y - 800.0)


# ── The sled, the snowshoes, the rocks ───────────────────────
## The little things, in one mesh: the snowshoes leaning on the front wall by the corner glass
## door, the sled at the foot of the deck steps, and granite boulders round the yard's edge and
## along the shore (the weather's snow caps them).
static func _build_snow_things(parent: Node3D, surf: Dictionary) -> void:
	var b := Builder.Buf.new()
	var rng := RandomNumberGenerator.new()
	rng.seed = 1911
	_build_snowshoes(b)
	_build_sled(b)
	b.mat = Builder.S_STONE
	var spots: Array[Vector2] = []
	var tries := 0
	while spots.size() < 30 and tries < 2000:
		tries += 1
		var p: Vector2
		if spots.size() < 16:
			var ang := rng.randf_range(-1.5, 1.5)
			if absf(ang) < 0.3:
				continue                                 # the view straight out stays open
			var dir := Vector2(sin(ang), -cos(ang))
			var edge := shore_r(YARD.x + dir.x * 50.0, YARD.y + dir.y * 50.0)
			if edge > 120.0:
				continue
			p = YARD + dir * (edge + rng.randf_range(-4.0, 1.0))
		else:
			var a := rng.randf() * TAU
			p = YARD + Vector2(cos(a) * 1.15, sin(a)) * rng.randf_range(YARD_R + 2.0, 60.0)
		if on_cabin(p.x, p.y, 2.0) or on_slope(p.x, p.y) and spots.size() >= 16 or path_distance(p.x, p.y) < 2.0:
			continue
		spots.append(p)
	for p: Vector2 in spots:
		var size := Vector3(rng.randf_range(0.8, 2.4), rng.randf_range(0.4, 1.1), rng.randf_range(0.7, 2.0))
		var basis := Basis(Vector3.UP, rng.randf() * TAU) * Basis(Vector3.RIGHT, rng.randf_range(-0.1, 0.1))
		# (half sunk: the snow has drifted round them)
		var y := maxf(height(p.x, p.y), ICE_Y) + size.y * 0.1
		b.soft_box(Transform3D(basis, Vector3(p.x, y, p.y)), size, minf(size.x, size.z) * 0.45, C_GRANITE.darkened(rng.randf_range(0.0, 0.3)))
	Builder._add_mesh(parent, "SnowThings", b.to_mesh(surf), null, true)


## A pair of traditional snowshoes (a teardrop frame with a tail, laced across) leaning against
## the front wall just right of the corner glass door, on the deck.
static func _build_snowshoes(b: Builder.Buf) -> void:
	for k in 2:
		var foot := Vector3(-4.55 + 0.42 * float(k), Builder.DECK_Y + 0.01, -0.34 + 0.05 * float(k))
		# leaning back onto the wall: up the shoe = up and a little towards the wall (+z)
		var up := Vector3(0.04 * float(k), 1.0, 0.3).normalized()
		var across := Vector3(1.0, 0.0, 0.0)
		var out_n := across.cross(up).normalized()
		var xf := Transform3D(Basis(across, up, -out_n), foot)
		# the frame: a loop of short rods round a teardrop (wide at the toe, tapering to a tail)
		var pts: Array[Vector3] = []
		for i in 21:
			var t := float(i) / 20.0 * TAU
			var s := sin(t)
			var c := cos(t)
			var wide := 0.2 * (0.55 + 0.45 * (1.0 + c) * 0.5)
			pts.append(Vector3(s * wide * (1.0 - 0.75 * maxf(-c, 0.0)), 0.55 + c * 0.55, 0.0))
		b.mat = Builder.S_TIMBER
		for i in 20:
			b.rod(xf * pts[i], xf * pts[i + 1], 0.012, 5, C_SHOE_FRAME)
		# the lacing: a few cross strands and two long ones
		b.mat = Builder.S_PLAIN
		for h: float in [0.25, 0.45, 0.65, 0.8, 0.92]:
			var half := 0.2 * (0.55 + 0.45 * h) * 0.92
			b.rod(xf * Vector3(-half, h, 0.0), xf * Vector3(half, h, 0.0), 0.004, 3, C_SHOE_LACE)
		for sx: float in [-0.06, 0.06]:
			b.rod(xf * Vector3(sx, 0.1, 0.0), xf * Vector3(sx, 1.0, 0.0), 0.004, 3, C_SHOE_LACE)
		# the binding: a leather strap across the middle
		b.box(xf * Transform3D(Basis.IDENTITY, Vector3(0.0, 0.62, 0.01)), Vector3(0.22, 0.05, 0.02), Color(0.32, 0.2, 0.12))


## A wooden sled with red runners curling up at the front, standing in the snow at the foot of
## the deck steps with a rope lying from its front.
static func _build_sled(b: Builder.Buf) -> void:
	var mid := Vector2(10.0, -6.6)
	var y := height(mid.x, mid.y)
	var xf := Transform3D(Basis(Vector3.UP, 0.5), Vector3(mid.x, y, mid.y))   # -Z = its front
	b.mat = Builder.S_IRON
	for sx: float in [-0.24, 0.24]:
		var prev := Vector3(sx, 0.04, 0.55)
		for i in 9:
			var t := float(i + 1) / 9.0
			var p := Vector3(sx, 0.04, 0.55 - 1.1 * t)
			if t > 0.75:
				# the curl at the front
				var a := (t - 0.75) / 0.25 * PI * 0.9
				p = Vector3(sx, 0.04 + 0.12 * (1.0 - cos(a)), -0.28 - 0.14 * sin(a))
			b.rod(xf * prev, xf * p, 0.018, 5, C_RUNNER)
			prev = p
		# the uprights from the runner to the deck slats
		for z: float in [0.45, 0.05, -0.3]:
			b.rod(xf * Vector3(sx, 0.05, z), xf * Vector3(sx * 0.9, 0.17, z), 0.016, 5, C_RUNNER)
	b.mat = Builder.S_TIMBER
	for i in 5:
		var z := 0.48 - 0.21 * float(i)
		b.box(xf * Transform3D(Basis.IDENTITY, Vector3(0.0, 0.19, z)), Vector3(0.56, 0.025, 0.15), C_SLED.lightened(0.05 * float(i % 2)))
	for sx: float in [-0.25, 0.25]:
		b.box(xf * Transform3D(Basis.IDENTITY, Vector3(sx, 0.165, 0.08)), Vector3(0.05, 0.03, 0.95), C_SLED.darkened(0.2))
	# the steering bar across the front, and the rope from it to the snow
	b.box(xf * Transform3D(Basis.IDENTITY, Vector3(0.0, 0.2, -0.36)), Vector3(0.62, 0.035, 0.06), C_SLED.darkened(0.1))
	b.mat = Builder.S_PLAIN
	var rope := Color(0.7, 0.62, 0.46)
	var a := xf * Vector3(-0.2, 0.2, -0.38)
	var c := xf * Vector3(0.05, 0.02, -0.95)
	var d := xf * Vector3(0.35, 0.02, -1.3)
	var e := xf * Vector3(-0.2, 0.2, -0.38) + (xf.basis * Vector3(0.4, 0.0, 0.0))
	b.rod(a, c, 0.008, 4, rope)
	b.rod(c, d, 0.008, 4, rope)
	b.rod(d, e.lerp(d, 0.4) + Vector3(0.0, -0.05, 0.0), 0.008, 4, rope)


# ── Trees ────────────────────────────────────────────────────
## Where the detailed trees stand: [foot, height, kind]. Kinds: spruce (most: tall and narrow)
## and pine (a few big old ones). None on the open slope, the path or the ice; nothing in front
## of the deck that would rise into the view.
static func _place_trees(rng: RandomNumberGenerator) -> Array:
	var trees: Array = []
	var taken: Array[Vector2] = []
	var tries := 0
	while trees.size() < TREE_COUNT and tries < 9000:
		tries += 1
		var r := lerpf(TREE_RANGE.x, TREE_RANGE.y, pow(rng.randf(), 1.4))
		var a := rng.randf() * TAU
		var p := YARD + Vector2(cos(a) * r * 1.15, sin(a) * r)
		if on_cabin(p.x, p.y, 3.0) or on_slope(p.x, p.y) or path_distance(p.x, p.y) < 2.5:
			continue
		var y := height(p.x, p.y)
		if y < ICE_Y + 0.9:
			continue                                     # the shore and the ice
		var too_close := false
		for q: Vector2 in taken:
			if q.distance_squared_to(p) < 9.0:
				too_close = true
				break
		if too_close:
			continue
		var kind := "spruce"
		var tall := rng.randf_range(10.0, 20.0)
		if rng.randf() < 0.08:
			kind = "pine"
			tall = rng.randf_range(16.0, 24.0)
		var ahead := (YARD.y - p.y) / maxf(p.distance_to(YARD), 0.01)
		if ahead > 0.45 and y + tall * 0.95 > VIEW_Y:
			continue                                     # it would stand in the deck's view
		taken.append(p)
		trees.append([Vector3(p.x, y, p.y), tall, kind])
	return trees


## The cheap tree shape (the Lakeside Campfire's low-poly fir, 1 unit tall, a little darker),
## in an array so it reads like the other scenes' (theirs also have a round leafy one).
static func _lowpoly_shapes() -> Array:
	var fir := CampBuilder.Buf.new()
	fir.cyl(Transform3D.IDENTITY, 0.035, 0.02, 0.5, 6, Color(0.18, 0.12, 0.08))
	for t: Array in [[0.14, 0.25, 0.32], [0.33, 0.2, 0.3], [0.52, 0.15, 0.27], [0.7, 0.1, 0.3]]:
		var green := Color(0.03, 0.1, 0.07).lerp(Color(0.05, 0.15, 0.1), float(t[0]))
		fir.cyl(Transform3D(Basis.IDENTITY, Vector3(0.0, float(t[0]), 0.0)), float(t[1]), 0.0, float(t[2]), 8, green)
	fir.alpha_by_height(1.0)
	return [fir]


## The far forest on the arms of the shore, the slope behind and the island: low-poly firs only
## (no leafy trees this far north). Returns its MultiMeshInstance3D in an array.
static func _build_far_forest(parent: Node3D, rng: RandomNumberGenerator, shapes: Array, mat: Material) -> Array[Node3D]:
	var firs: Array[Transform3D] = []
	var tints := PackedColorArray()
	var tries := 0
	while firs.size() < FAR_COUNT and tries < FAR_COUNT * 6:
		tries += 1
		var p: Vector2
		var r: float
		if rng.randf() < 0.05:
			var a := rng.randf() * TAU
			p = ISLAND + Vector2(cos(a), sin(a)) * ISLAND_R * sqrt(rng.randf()) * 0.75
			r = p.distance_to(YARD)
		else:
			r = lerpf(FAR_RANGE.x, FAR_RANGE.y, sqrt(rng.randf()))
			var a := rng.randf() * TAU
			p = YARD + Vector2(cos(a), sin(a)) * r
		var y := height(p.x, p.y)
		if y < ICE_Y + 0.8:
			continue
		var tall := rng.randf_range(11.0, 19.0) * (1.0 + r / 1500.0)
		var ahead := (YARD.y - p.y) / maxf(r, 0.01)
		if ahead > 0.45 and y + tall > VIEW_Y and r < 90.0:
			continue
		var wide := tall * rng.randf_range(0.75, 1.05)          # (narrower than the lake's firs)
		var shade := rng.randf_range(0.6, 1.0)
		firs.append(Transform3D(Basis(Vector3.UP, rng.randf() * TAU).scaled(Vector3(wide * 0.55, tall, wide * 0.55)), Vector3(p.x, y - 0.3, p.y)))
		tints.append(Color(shade, shade, shade))
	var out: Array[Node3D] = [CampBuilder._add_trees(parent, "FarFirs", shapes[0], firs, tints, mat)]
	return out


## The Simple look's near trees: the same spots as the detailed ones, drawn with the low-poly fir.
static func _build_simple_trees(parent: Node3D, trees: Array, shapes: Array, mat: Material) -> Node3D:
	var holder := Node3D.new()
	holder.name = "SimpleTrees"
	parent.add_child(holder)
	var firs: Array[Transform3D] = []
	var tints := PackedColorArray()
	for one: Array in trees:
		var foot: Vector3 = one[0]
		var tall := float(one[1])
		var slim := 0.3 if String(one[2]) == "spruce" else 0.38
		var turn := Basis(Vector3.UP, fmod(foot.x * 1.7 + foot.z * 0.9, TAU))
		var shade := 0.8 + 0.3 * fmod(absf(foot.x * 0.37 + foot.z * 0.21), 1.0)
		firs.append(Transform3D(turn.scaled(Vector3(tall * slim, tall, tall * slim)), foot))
		tints.append(Color(shade, shade, shade))
	CampBuilder._add_trees(holder, "Firs", shapes[0], firs, tints, mat)
	return holder


## The Detailed look's trees (hidden until the room script shows them): the campfire's leaf-card
## firs drawn tall, narrow and dark as spruces, a few pines, and young spruces poking out of the
## snow round their feet (no grass or ferns under the snow). One MultiMesh per kind
## (campfire_trees.gd kit(), which brings its own materials, handed on through the node's "mats"
## meta; the weather frosts them).
static func _build_detailed_plants(parent: Node3D, trees: Array, rng: RandomNumberGenerator) -> Node3D:
	var holder := Node3D.new()
	holder.name = "DetailedPlants"
	holder.visible = false
	parent.add_child(holder)
	var mats := Trees.materials(0.05)
	holder.set_meta("mats", mats)
	var spots: Dictionary = {}      # kit kind -> [[Transform3D, shade], ...]
	for one: Array in trees:
		var foot: Vector3 = one[0]
		var tall := float(one[1])
		var turn := Basis(Vector3.UP, rng.randf() * TAU)
		var shade := rng.randf_range(0.7, 0.95)
		if String(one[2]) == "pine":
			_spot(spots, "pine", Transform3D(turn.scaled(Vector3(tall * 0.5, tall * 1.05, tall * 0.5)), foot - Vector3(0.0, 0.05, 0.0)), shade)
		else:
			# a spruce: the fir card tree, narrow and steeple-shaped
			_spot(spots, "fir", Transform3D(turn.scaled(Vector3(tall * 0.34, tall * 1.15, tall * 0.34)), foot - Vector3(0.0, 0.05, 0.0)), shade * 0.8)
		if foot.distance_to(Vector3(YARD.x, foot.y, YARD.y)) < 70.0 and rng.randf() < 0.45:
			var off := Vector3(rng.randf_range(-3.0, 3.0), 0.0, rng.randf_range(-3.0, 3.0))
			if not on_ice(foot.x + off.x, foot.z + off.z, 4.0) and not on_slope(foot.x + off.x, foot.z + off.z):
				var yt := rng.randf_range(1.6, 4.0)
				_spot(spots, "young_fir", Transform3D(Basis(Vector3.UP, rng.randf() * TAU).scaled(Vector3(yt * 0.38, yt, yt * 0.38)),
					Vector3(foot.x + off.x, height(foot.x + off.x, foot.z + off.z) - 0.2, foot.z + off.z)), 0.75)
	for kind: String in spots:
		var list: Array = spots[kind]
		var mm := MultiMesh.new()
		mm.transform_format = MultiMesh.TRANSFORM_3D
		mm.use_colors = true
		mm.mesh = Trees.kit(kind, mats)
		mm.instance_count = list.size()
		for i in list.size():
			mm.set_instance_transform(i, list[i][0])
			var s := float(list[i][1])
			mm.set_instance_color(i, Color(s, s, s))
		var mmi := MultiMeshInstance3D.new()
		mmi.name = kind.to_pascal_case()
		mmi.multimesh = mm
		mmi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_ON
		holder.add_child(mmi)
	return holder


static func _spot(spots: Dictionary, kind: String, xf: Transform3D, shade: float) -> void:
	if not spots.has(kind):
		spots[kind] = []
	(spots[kind] as Array).append([xf, shade])
